.env
.env.*
*.log
.DS_Store
__pycache__/
.venv/
node_modules/
dist/
build/
latex/render/

# OmpF downloaded/generated data stays local; retain curated inputs and reports.
/sources/ompf/prepared/
/sources/ompf/structures/
/sources/ompf/raw/*
!/sources/ompf/raw/*_audit.md
/notes/ompf/*
!/notes/ompf/*.md

# Predictive benchmarks: keep partitions/code/reports, ignore caches and runs.
/sources/predictive/raw/
/sources/predictive/features/
/notes/predictive/*
!/notes/predictive/*.md

# Accelerated method survey: downloaded tools/weights and generated benchmarks.
/sources/accelerated/raw/
/notes/accelerated/*
!/notes/accelerated/*.md

# Six-hour predictive physics sprint: generated/downloaded artifacts.
/sources/sprint/raw/
/sources/sprint/features/
/notes/sprint/*
!/notes/sprint/*.md

# Partitions regenerate deterministically; track compact expected hashes.
/sources/sprint/*partitions.csv
